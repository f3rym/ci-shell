module github.com/f3rym/ci-shell

// go 1.26 в тулчейнах не существует — сборка не шла вообще. Код не
// использует ничего новее Go 1.21 (ни дженериков, ни range-over-func —
// только stdlib и единственная внешняя зависимость из require ниже),
// поэтому нижняя граница берётся самой широкой из заведомо существующих
// версий: собирается и на машине с 1.25, и на машине с 1.26. Директива
// toolchain не добавляется — она снова прибила бы сборку к одному
// конкретному выпуску.
go 1.25

// Косвенные зависимости и go.sum в этом релизе не восстанавливаются: проект
// верифицируется чтением исходников без сети (PROJECT.md), поэтому
// `go mod tidy`/`go mod download` здесь не запускались. Первая настоящая
// сборка потребует одного вызова `go mod tidy` — это ожидаемое следствие
// ограничения проекта, а не поломка зависимостей или их подмена.
require (
	gopkg.in/yaml.v3 v3.0.1
	charm.land/bubbletea/v2 v2.0.8
	charm.land/lipgloss/v2 v2.0.5
	charm.land/bubbles/v2 v2.1.1
)
